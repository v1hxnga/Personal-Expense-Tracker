<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Personal Expense Tracker built with C# and ASP.NET Core." />

    <title>
        @ViewData["Title"] - Personal Expense Tracker
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>

    <header class="top-navbar">

        <div class="nav-container">

            <a class="brand"
               asp-page="/Index">

                <span class="brand-icon">
                    $
                </span>

                <span>
                    Personal Expense Tracker
                </span>

            </a>

        </div>

    </header>


    <main>
        @RenderBody()
    </main>


    <footer>

        <div class="footer-container">

            <span>
                Personal Expense Tracker
            </span>

        </div>

    </footer>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>